# --- App ---
PORT=3003

# --- Database (own DB — Database per Service) ---
DB_HOST=project-db
DB_PORT=5432
DB_USER=project_user
DB_PASSWORD=project_pass
DB_NAME=project_db

# --- JWT ---
# MUST be the SAME value as the Auth service's JWT_ACCESS_SECRET, otherwise
# tokens issued by Auth won't verify here. Leave empty in the repo.
JWT_ACCESS_SECRET=

# --- Redis (dashboard / list caching) ---
REDIS_HOST=redis
REDIS_PORT=6379
