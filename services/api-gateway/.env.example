# --- App ---
PORT=3000

# --- JWT ---
# MUST be the SAME value as the Auth service's JWT_ACCESS_SECRET. The gateway
# verifies every protected request once here, before it ever reaches a
# downstream service. Leave empty in the repo.
JWT_ACCESS_SECRET=

# --- Downstream services (container DNS names inside docker-compose) ---
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
PROJECT_SERVICE_URL=http://project-service:3003
TASK_SERVICE_URL=http://task-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# --- CORS (needed for the refresh-token cookie) ---
# The frontend origin allowed to send credentialed requests. Leave empty in
# dev to reflect the caller's origin automatically; set explicitly in prod.
CORS_ORIGIN=
