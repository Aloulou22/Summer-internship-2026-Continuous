# --- App ---
PORT=3004

# --- Database (own DB — Database per Service) ---
DB_HOST=task-db
DB_PORT=5432
DB_USER=task_user
DB_PASSWORD=task_pass
DB_NAME=task_db

# --- JWT ---
# MUST be the SAME value as the Auth service's JWT_ACCESS_SECRET, otherwise
# tokens issued by Auth won't verify here. Leave empty in the repo.
JWT_ACCESS_SECRET=

# --- Kafka (PRODUCER — publishes to task-events) ---
KAFKA_BROKER=kafka:9092

# --- Redis (board/list caching) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Project Service (used to verify project membership on every task
# request — see src/projects/projects-client.service.ts) ---
PROJECT_SERVICE_URL=http://project-service:3003
