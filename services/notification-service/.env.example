# --- App ---
PORT=3005

# --- Database (own DB — Database per Service) ---
DB_HOST=notification-db
DB_PORT=5432
DB_USER=notification_user
DB_PASSWORD=notification_pass
DB_NAME=notification_db

# --- JWT ---
# MUST be the SAME value as the Auth service's JWT_ACCESS_SECRET, otherwise
# tokens issued by Auth won't verify here. Leave empty in the repo.
JWT_ACCESS_SECRET=

# --- Kafka (CONSUMER — subscribes to task-events and user.registered) ---
KAFKA_BROKER=kafka:9092
