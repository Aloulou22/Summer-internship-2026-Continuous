# --- App ---
PORT=3001

# --- Database (matches docker-compose service name) ---
DB_HOST=auth-db
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass
DB_NAME=auth_db

# --- JWT ---
# DO NOT commit a real secret. Generate a strong one per environment with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app refuses to start if this is shorter than 32 chars.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m

# --- Refresh tokens ---
# Refresh tokens are random 48-byte strings, hashed (SHA-256) before storage.
# No salt is configured because high-entropy tokens don't need one.
REFRESH_TTL_DAYS=7

# --- Kafka ---
KAFKA_BROKER=kafka:9092

# --- CORS (needed for the refresh-token cookie) ---
# The frontend origin allowed to send credentialed requests. Leave empty in
# dev to reflect the caller's origin automatically; set explicitly in prod.
CORS_ORIGIN=

# --- Bootstrap admin ---
# On startup, this account is created (or promoted if it already registered)
# with role=admin — the only way to get the first admin without editing the
# database directly. From then on, further admin/manager grants go through
# PATCH /auth/users/:id/role (admin only). Leave both empty to skip this.
ADMIN_EMAIL=
ADMIN_PASSWORD=
