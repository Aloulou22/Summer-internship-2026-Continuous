# --- App ---
PORT=3001

# --- Database (matches docker-compose service name) ---
DB_HOST=auth-db
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass
DB_NAME=auth_db

# --- JWT ---
# DO NOT commit a real secret. Generate a strong one per environment with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app refuses to start if this is shorter than 32 chars.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m

# --- Refresh tokens ---
# Refresh tokens are random 48-byte strings, hashed (SHA-256) before storage.
# No salt is configured because high-entropy tokens don't need one.
REFRESH_TTL_DAYS=7
